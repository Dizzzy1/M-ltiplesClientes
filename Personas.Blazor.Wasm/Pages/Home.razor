@page "/"
@using Personas.Blazor.Wasm.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Gestión de Personas</PageTitle>

<h3>Gestión de Personas</h3>

<div class="card p-4 mb-4">
    <h5>Registrar nueva persona</h5>

    <div class="mb-3">
        <label class="form-label">Nombre:</label>
        <input class="form-control" @bind="persona.Nombre" />
    </div>

    <div class="mb-3">
        <label class="form-label">Apellido:</label>
        <input class="form-control" @bind="persona.Apellido" />
    </div>

    <div class="mb-3">
        <label class="form-label">Edad:</label>
        <input type="number" class="form-control"
               @bind="persona.Edad" />
    </div>

    <button class="btn btn-primary me-2"
            @onclick="GuardarPersona">
        Guardar
    </button>

    <button class="btn btn-secondary"
            @onclick="ConsultarPersonas">
        Consultar
    </button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-info">@mensaje</div>
}

<h5>Lista de personas</h5>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Edad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in personas)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nombre</td>
                <td>@p.Apellido</td>
                <td>@p.Edad</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Persona persona = new();
    private List<Persona> personas = new();
    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await ConsultarPersonas();
    }

    private async Task ConsultarPersonas()
    {
        try
        {
            personas = await Http.GetFromJsonAsync<List<Persona>>(
                "api/Personas") ?? new List<Persona>();

            mensaje = "Personas consultadas correctamente.";
        }
        catch (Exception ex)
        {
            mensaje = "Error al consultar: " + ex.Message;
        }
    }

    private async Task GuardarPersona()
    {
        if (string.IsNullOrWhiteSpace(persona.Nombre) ||
            string.IsNullOrWhiteSpace(persona.Apellido) ||
            persona.Edad <= 0)
        {
            mensaje = "Completa todos los campos correctamente.";
            return;
        }

        try
        {
            var respuesta = await Http.PostAsJsonAsync(
                "api/Personas", persona);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Persona guardada correctamente.";

                persona = new Persona();

                await ConsultarPersonas();
            }
            else
            {
                mensaje = "No se pudo guardar la persona.";
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al guardar: " + ex.Message;
        }
    }
}
